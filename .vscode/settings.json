{
  // Disable the default formatter, use eslint instead
  "prettier.enable": false,
  "editor.formatOnSave": false,

  // Auto fix
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },

  // Silent the stylistic rules in your IDE, but still auto fix them
  "eslint.rules.customizations": [
    { "rule": "style/*", "severity": "off", "fixable": true },
    { "rule": "format/*", "severity": "off", "fixable": true },
    { "rule": "*-indent", "severity": "off", "fixable": true },
    { "rule": "*-spacing", "severity": "off", "fixable": true },
    { "rule": "*-spaces", "severity": "off", "fixable": true },
    { "rule": "*-order", "severity": "off", "fixable": true },
    { "rule": "*-dangle", "severity": "off", "fixable": true },
    { "rule": "*-newline", "severity": "off", "fixable": true },
    { "rule": "*quotes", "severity": "off", "fixable": true },
    { "rule": "*semi", "severity": "off", "fixable": true }
  ],

  // Enable eslint for all supported languages
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "json5",
    "jsonc",
    "yaml",
    "toml",
    "xml",
    "gql",
    "graphql",
    "astro",
    "svelte",
    "css",
    "less",
    "scss",
    "pcss",
    "postcss"
  ],
  // ============================================
  // MDC EXTENSION CONFIGURATION
  // ============================================

  // Enable formatting untuk MDC files
  "mdc.enableFormatting": true,

  // Enable component metadata completions (autocomplete)
  "mdc.enableComponentMetadataCompletions": true,

  // Local component metadata pattern (dari nuxt-component-meta)
  "mdc.componentMetadataLocalFilePattern": "**/.nuxt/component-meta.mjs",
  "mdc.componentMetadataLocalExcludePattern": "{**/node_modules/**,**/dist/**,**/.output/**,**/.cache/**,**/.playground/**}",

  // Cache TTL untuk component metadata (dalam menit)
  "mdc.componentMetadataCacheTTL": 30,

  // MDC file-specific editor settings
  "[mdc]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": false,
    "editor.wordWrap": "on"
  },

  // Markdown file settings (untuk content/ folder)
  "[markdown]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "on",
      "strings": "on",
      "other": "on"
    }
  },

  // File associations untuk MDC
  "files.associations": {
    "*.md": "markdown",
    "*.mdc": "mdc"
  }
}
